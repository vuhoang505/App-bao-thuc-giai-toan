<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/alarm_gradient">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_horizontal" android:orientation="vertical" android:padding="28dp">
        <TextView android:id="@+id/textCurrentTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:textColor="#FFFFFF" android:textSize="64sp" android:textStyle="bold" tools:text="07:00" />
        <TextView android:id="@+id/textAlarmLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#DDE3FF" android:textSize="20sp" tools:text="@string/alarm_default_label" />
        <TextView android:id="@+id/textProgress" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="42dp" android:background="@drawable/progress_pill" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" tools:text="Câu 1/3" />
        <TextView android:id="@+id/textQuestion" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="38sp" android:textStyle="bold" tools:text="7 + 5 = ?" />
        <EditText android:id="@+id/editAnswer" android:layout_width="220dp" android:layout_height="64dp"
            android:layout_marginTop="22dp" android:background="@drawable/input_background" android:gravity="center" android:hint="@string/answer_hint"
            android:imeOptions="actionDone" android:importantForAutofill="no" android:inputType="numberSigned" android:maxLength="8" android:textSize="24sp" />
        <TextView android:id="@+id/textFeedback" android:layout_width="match_parent" android:layout_height="28dp"
            android:layout_marginTop="8dp" android:gravity="center" android:textColor="#FFE082" android:textStyle="bold" />
        <Button android:id="@+id/buttonCheck" style="@style/PrimaryButton" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginTop="10dp" android:text="@string/check_answer" />
        <Button android:id="@+id/buttonSnooze" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="12dp" android:background="@drawable/button_secondary" android:text="@string/snooze_five_minutes" android:textAllCaps="false" />
        <Button android:id="@+id/buttonEmergency" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="8dp" android:background="@android:color/transparent" android:text="@string/emergency_stop" android:textAllCaps="false" android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
